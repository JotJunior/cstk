#!/bin/sh
# cstk — Claude Specs Toolkit CLI
#
# Ponto de entrada do CLI que instala, atualiza e audita skills do toolkit
# em escopo global (~/.claude/skills/) ou de projeto (./.claude/skills/),
# alem de atualizar seu proprio binario.
#
# Esta implementacao cobre FASE 1.1 do backlog em
# docs/specs/cstk-cli/tasks.md: scaffold + dispatch + --version + --help.
# Subcomandos (install/update/self-update/list/doctor) sao implementados em
# cli/lib/*.sh em fases subsequentes; ate la, dispatch para eles reporta
# "nao implementado" com exit 1.
#
# POSIX sh puro conforme Constitution 1.1.0 §Principio II.
# Deps: shell POSIX + find, grep, sed, dirname, cd, printf, cat.

set -eu

# ==== Versao embutida (atomicidade par bin+lib — FR-006) ====
#
# Esta string e substituida por `cstk self-update` (sed na copia .new) e pelo
# pipeline de release (FASE 9.1) ao construir o tarball para uma tag SemVer.
# Em dev (rodando do repo), fica como "0.0.0-dev" e o boot-check abaixo
# trata isso como bypass — comparar com VERSION do lib so faz sentido apos
# instalacao via bootstrap.
CSTK_EMBEDDED_VERSION="0.0.0-dev"

# ==== Exit codes (contract: docs/specs/cstk-cli/contracts/cli-commands.md) ====

CSTK_EXIT_OK=0
CSTK_EXIT_ERROR=1
CSTK_EXIT_USAGE=2
CSTK_EXIT_LOCK=3
CSTK_EXIT_LOCAL_EDIT=4
CSTK_EXIT_CHECK_AVAILABLE=10

# ==== Resolucao de paths ====

# Resolve o diretorio da biblioteca (cli/lib/).
# Prioridade: $CSTK_LIB override > layout instalado > layout de dev.
_resolve_lib_dir() {
  if [ -n "${CSTK_LIB:-}" ]; then
    printf '%s\n' "$CSTK_LIB"
    return 0
  fi
  _script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
  # Layout instalado: bin em ~/.local/bin/cstk, lib em ~/.local/share/cstk/lib
  if [ -d "$_script_dir/../share/cstk/lib" ]; then
    (cd -- "$_script_dir/../share/cstk/lib" && pwd)
    return 0
  fi
  # Layout de dev: lib adjacente ao cstk (repo: cli/cstk + cli/lib/)
  if [ -d "$_script_dir/lib" ]; then
    printf '%s\n' "$_script_dir/lib"
    return 0
  fi
  printf 'cstk: nao consegui localizar cli/lib/ (defina $CSTK_LIB ou reinstale via bootstrap)\n' >&2
  exit "$CSTK_EXIT_ERROR"
}

# Resolve o arquivo VERSION. Prioridade:
#   1. $CSTK_VERSION_FILE override (testes)
#   2. $CSTK_LIB/VERSION (canonico, atomic-com-lib desde FASE 5; usado pelo boot-check)
#   3. $CSTK_LIB/../VERSION (legado/dev: cli/VERSION na arvore do repo)
_resolve_version_file() {
  if [ -n "${CSTK_VERSION_FILE:-}" ]; then
    printf '%s\n' "$CSTK_VERSION_FILE"
    return 0
  fi
  if [ -f "$CSTK_LIB/VERSION" ]; then
    printf '%s\n' "$CSTK_LIB/VERSION"
    return 0
  fi
  printf '%s\n' "$CSTK_LIB/../VERSION"
}

# Boot-check: detecta a janela transiente entre rename de lib e rename de bin
# durante self-update (FR-006c). Compara CSTK_EMBEDDED_VERSION (no bin) com
# $CSTK_LIB/VERSION (atomic-com-lib). Mismatch = aborta com mensagem clara
# pedindo recovery via "cstk self-update".
#
# Bypass quando:
#   - CSTK_EMBEDDED_VERSION termina em -dev (rodando do repo)
#   - $CSTK_LIB/VERSION ausente (instalacao pre-FASE-5 via bootstrap antigo)
#   - flag CSTK_SKIP_BIN_LIB_CHECK=1 (escape hatch para depuracao)
_check_bin_lib_match() {
  if [ "${CSTK_SKIP_BIN_LIB_CHECK:-0}" = 1 ]; then
    return 0
  fi
  case "$CSTK_EMBEDDED_VERSION" in
    *-dev|"") return 0 ;;
  esac
  if [ ! -f "$CSTK_LIB/VERSION" ]; then
    return 0
  fi
  _libv=$(head -n 1 -- "$CSTK_LIB/VERSION" 2>/dev/null | tr -d '[:space:]')
  if [ -z "$_libv" ]; then
    return 0
  fi
  if [ "$_libv" != "$CSTK_EMBEDDED_VERSION" ]; then
    printf 'cstk: bin/lib version mismatch (bin=%s lib=%s)\n' \
      "$CSTK_EMBEDDED_VERSION" "$_libv" >&2
    printf 'cstk: self-update parece estar em progresso ou interrompido.\n' >&2
    printf 'cstk: re-execute "cstk self-update" para completar a recuperacao.\n' >&2
    exit "$CSTK_EXIT_ERROR"
  fi
}

# ==== Comandos internos (nao vivem em cli/lib/) ====

_cmd_version() {
  _vf=$(_resolve_version_file)
  if [ -f "$_vf" ]; then
    _v=$(head -n 1 -- "$_vf" 2>/dev/null) || _v=""
    if [ -n "$_v" ]; then
      printf 'cstk %s\n' "$_v"
    else
      printf 'cstk unknown (VERSION vazio em %s)\n' "$_vf"
    fi
  else
    printf 'cstk unknown (VERSION nao encontrado em %s)\n' "$_vf"
  fi
  exit "$CSTK_EXIT_OK"
}

_cmd_help() {
  _sub="${1:-}"
  if [ -z "$_sub" ]; then
    cat <<'HELP'
cstk — Claude Specs Toolkit CLI

USO:
  cstk <comando> [opcoes]

COMANDOS:
  install       Instala skills do toolkit em escopo global ou de projeto
  update        Atualiza skills ja instaladas
  self-update   Atualiza o proprio binario cstk
  list          Lista skills instaladas
  doctor        Verifica integridade da instalacao e manifests
  session       Sessoes paralelas via git worktree (start/list/end/pr)
  recall        Busca cross-feature na memoria de conhecimento (SQLite+FTS5);
                tambem --ingest (pos-onda) e --reindex (reconstrucao)
  show-tip      Exibe uma dica sobre uma skill do toolkit (aleatoria ou por SKILL/--phase)
  serve         Inicia o painel web cstk; baixa e instala na primeira execucao
  state         Operacoes sobre o estado transacional 00c (state migrate)
  mcp           Servidor MCP de estado das execucoes 00c (mcp status)
  hooks         Provisiona os hooks do runtime 00c num projeto-alvo
                (so hooks + settings.json; nao duplica skill/commands/agents)
  usage         Consulta o consumo avulso (fora de execucoes 00c); tambem
                `usage compare` (avulso vs pipeline) e `usage prune` (TTL)
  setup         Wizard guiado das 4 areas de configuracao recomendadas
                (hooks, backend de estado, MCP, telemetria) num projeto-alvo
  00c <path>    Bootstrap interativo de projeto-alvo do agente-00C
                (cria diretorio, coleta parametros e invoca claude)

UTILITARIOS:
  help [CMD]    Ajuda geral ou de um comando especifico
  --version     Imprime versao instalada

FLAGS GLOBAIS (aceitas pelos comandos principais):
  --scope <global|project>   Default global; project usa ./.claude/skills/
  --dry-run                  Mostra plano sem escrever
  --yes                      Pula confirmacoes interativas
  --verbose                  Log verboso em stderr

Documentacao completa: docs/specs/cstk-cli/contracts/cli-commands.md
HELP
    exit "$CSTK_EXIT_OK"
  fi
  case "$_sub" in
    hooks)
      printf 'cstk help hooks: provisiona os hooks do runtime 00c num projeto-alvo.\n'
      printf 'Toca apenas .claude/hooks/ + .claude/settings.json — nao duplica\n'
      printf 'skill/commands/agents como "cstk install --scope project".\n'
      printf 'Para help inline, rode: cstk hooks --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    state)
      printf 'cstk help state: consulte docs/specs/state-db-foundation/contracts/migration.md\n'
      printf 'Para help inline, rode: cstk state --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    mcp)
      printf 'cstk help mcp: consulte docs/specs/state-mcp-server/contracts/mcp-session-lifecycle.md\n'
      printf 'Para help inline, rode: cstk mcp --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    install|update|self-update|list|doctor|session|serve)
      printf 'cstk help %s: consulte docs/specs/cstk-cli/contracts/cli-commands.md §%s\n' \
        "$_sub" "$_sub"
      exit "$CSTK_EXIT_OK"
      ;;
    recall)
      printf 'cstk help recall: consulte docs/specs/_archived/cstk-knowledge-db/contracts/cstk-recall.md\n'
      printf 'Para help inline, rode: cstk recall --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    show-tip)
      printf 'cstk help show-tip: consulte docs/specs/show-tips/contracts/cli-show-tip.md\n'
      printf 'Para help inline, rode: cstk show-tip --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    usage)
      printf 'cstk help usage: consulte docs/specs/loose-usage-capture/contracts/cli-usage.md\n'
      printf 'Para help inline, rode: cstk usage --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    setup)
      printf 'cstk help setup: consulte docs/specs/cstk-setup/contracts/cli-setup.md\n'
      printf 'Para help inline, rode: cstk setup --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    00c)
      printf 'cstk help 00c: consulte docs/specs/cstk-cli/contracts/cstk-00c.md\n'
      printf 'Para help inline, rode: cstk 00c --help\n'
      exit "$CSTK_EXIT_OK"
      ;;
    telemetry)
      cat <<'TELHELP'
cstk help telemetry — medicao local de custo/tokens do Claude Code

O exporter OTel vive DENTRO de cada processo `claude` (nasce e morre com a
sessao) e cada processo precisa da PROPRIA porta. Por isso a ativacao e um
wrapper `claude()` no seu shell rc (~/.zshrc ou ~/.bashrc, conforme $SHELL),
que sorteia uma porta livre por lancamento e liga as variaveis SO no
ambiente do processo `claude` — nada fica exportado no shell (evita o falso
alarme "exporter-down" em terminais sem sessao ativa) e nada sai da maquina
(exporter escuta apenas em 127.0.0.1).

O `cstk install` oferece esse opt-in na primeira instalacao. Se voce
recusou (ou instalou em ambiente nao-interativo), cole o bloco abaixo no
final do seu shell rc e rode `source <rc>` (ou abra um novo terminal):

# >>> cstk telemetry >>>
# Gerenciado por `cstk install` — medicao LOCAL de custo/tokens do Claude
# Code (nada sai da maquina; exporter escuta so em 127.0.0.1, porta sorteada
# por processo). Remova o bloco inteiro entre os marcadores para desativar.
claude() {
  local _otel_port
  _otel_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()' 2>/dev/null)
  if [ -n "$_otel_port" ]; then
    CLAUDE_CODE_ENABLE_TELEMETRY=1 \
    OTEL_METRICS_EXPORTER=prometheus \
    OTEL_EXPORTER_PROMETHEUS_PORT=$_otel_port \
    CSTK_OTEL_ENDPOINT="http://127.0.0.1:${_otel_port}/metrics" \
    command claude "$@"
  else
    CLAUDE_CODE_ENABLE_TELEMETRY=1 \
    OTEL_METRICS_EXPORTER=prometheus \
    command claude "$@"
  fi
}
# <<< cstk telemetry <<<

Verificacao (de dentro de uma sessao claude lancada pelo wrapper):
  ~/.claude/skills/agente-00c-runtime/scripts/otel-usage.sh preflight
  # esperado: status=ok  (fora de sessao: disabled e normal)

Snippet canonico: identico ao de cli/install.sh (telemetry_snippet) —
teste de paridade em tests/cstk/test_cstk-main.sh gateia drift entre os dois.
TELHELP
      exit "$CSTK_EXIT_OK"
      ;;
    help|--help|-h)
      _cmd_help ""
      ;;
    *)
      printf 'cstk: comando desconhecido para help: %s\n' "$_sub" >&2
      printf 'Comandos validos: install, update, self-update, list, doctor, session, recall, show-tip, serve, hooks, state, mcp, usage, setup, 00c, telemetry\n' >&2
      exit "$CSTK_EXIT_USAGE"
      ;;
  esac
}

# ==== Dispatch principal ====

_dispatch() {
  _cmd="${1:-}"
  [ "$#" -ge 1 ] && shift || :

  case "$_cmd" in
    ''|-h|--help)
      _cmd_help ""
      ;;
    help)
      _cmd_help "$@"
      ;;
    -V|--version|version)
      _cmd_version
      ;;
    serve)
      _check_bin_lib_match
      _lib_file="$CSTK_LIB/serve.sh"
      if [ ! -f "$_lib_file" ]; then
        printf 'cstk serve: nao implementado ainda (cli/lib/serve.sh ausente)\n' >&2
        exit "$CSTK_EXIT_ERROR"
      fi
      # shellcheck source=/dev/null
      . "$_lib_file"
      serve_main "$@"
      ;;
    install|update|self-update|list|doctor|session|recall|show-tip|hooks|state|mcp|usage|setup|plan-usage)
      # Boot-check para todos exceto self-update (que e o caminho de recovery
      # da janela transiente — bloquea-lo aqui causaria deadlock).
      case "$_cmd" in
        self-update) ;;
        *) _check_bin_lib_match ;;
      esac
      _lib_file="$CSTK_LIB/${_cmd}.sh"
      if [ ! -f "$_lib_file" ]; then
        printf 'cstk %s: nao implementado ainda (cli/lib/%s.sh ausente)\n' \
          "$_cmd" "$_cmd" >&2
        printf 'FASE 1.1 fornece apenas scaffold + dispatch; comandos sao adicionados em FASES 3-7.\n' >&2
        exit "$CSTK_EXIT_ERROR"
      fi
      # shellcheck source=/dev/null
      . "$_lib_file"
      # Convencao: cada lib define <cmd>_main; hifens viram underscores.
      _main_fn="$(printf '%s' "$_cmd" | sed 's/-/_/g')_main"
      if ! command -v "$_main_fn" >/dev/null 2>&1; then
        printf 'cstk: %s nao define funcao %s\n' "$_lib_file" "$_main_fn" >&2
        exit "$CSTK_EXIT_ERROR"
      fi
      "$_main_fn" "$@"
      ;;
    00c)
      # FASE 12: subcomando bootstrap interativo do agente-00C.
      # Special-case porque POSIX nao permite funcoes comecando com digito —
      # a funcao e `bootstrap_00c_main` (nao `00c_main`).
      _check_bin_lib_match
      _lib_file="$CSTK_LIB/00c-bootstrap.sh"
      if [ ! -f "$_lib_file" ]; then
        printf 'cstk 00c: nao implementado ainda (cli/lib/00c-bootstrap.sh ausente)\n' >&2
        exit "$CSTK_EXIT_ERROR"
      fi
      # shellcheck source=/dev/null
      . "$_lib_file"
      if ! command -v bootstrap_00c_main >/dev/null 2>&1; then
        printf 'cstk: %s nao define funcao bootstrap_00c_main\n' "$_lib_file" >&2
        exit "$CSTK_EXIT_ERROR"
      fi
      bootstrap_00c_main "$@"
      ;;
    -*)
      printf 'cstk: flag desconhecida: %s\n' "$_cmd" >&2
      printf 'Tente: cstk --help\n' >&2
      exit "$CSTK_EXIT_USAGE"
      ;;
    *)
      printf 'cstk: comando desconhecido: %s\n' "$_cmd" >&2
      printf 'Comandos validos: install, update, self-update, list, doctor, session, recall, show-tip, serve, hooks, state, mcp, usage, setup, 00c, help, --version\n' >&2
      exit "$CSTK_EXIT_USAGE"
      ;;
  esac
}

CSTK_LIB=$(_resolve_lib_dir)
_dispatch "$@"
